@baseUrl = http://localhost:8000

### ==============================================================================
### CASOS DE PRUEBA INICIALES (C-01 a C-08)
### ==============================================================================

### C-01: Un parámetro de ruta que no es entero
# Resultado esperado: 422 Unprocessable Entity (sin ejecutar el handler)
GET {{baseUrl}}/editoriales/abc


### C-02: Email o ISBN repetido
# 1. Crear primer cliente con email único
POST {{baseUrl}}/clientes/
Content-Type: application/json

{
  "nombre": "Juan Pérez",
  "email": "juan@example.com"
}

### 2. Intentar crear otro cliente con el mismo email
# Resultado esperado: 409 Conflict con mensaje propio
POST {{baseUrl}}/clientes/
Content-Type: application/json

{
  "nombre": "María Gómez",
  "email": "juan@example.com"
}


### C-03: Segundo perfil para el mismo cliente
# 1. Crear perfil válido para el cliente 1
POST {{baseUrl}}/clientes/1/perfil
Content-Type: application/json

{
  "telefono": "123456789",
  "direccion": "Calle Falsa 123"
}

### 2. Intentar crear un segundo perfil para el mismo cliente 1
# Resultado esperado: 409 Conflict
POST {{baseUrl}}/clientes/1/perfil
Content-Type: application/json

{
  "telefono": "987654321",
  "direccion": "Otra Calle 456"
}


### C-04: Libro con una editorial o un autor inexistente
# Intentar crear un libro con editorial_id 9999 (inexistente)
# Resultado esperado: 409 Conflict con mensaje propio
POST {{baseUrl}}/libros/
Content-Type: application/json

{
  "isbn": "978-950-00-0001-1",
  "titulo": "Libro Pruebas",
  "precio": "15000.00",
  "stock": 10,
  "editorial_id": 9999,
  "autores": [
    { "autor_id": 1, "rol": "autor", "orden": 1 }
  ]
}


### C-05: Venta con un cliente o un libro inexistente
# Resultado esperado: 409 Conflict
POST {{baseUrl}}/ventas/
Content-Type: application/json

{
  "cliente_id": 9999,
  "renglones": [
    { "libro_id": 1, "cantidad": 2 }
  ]
}


### C-06: Venta válida con dos renglones
# Resultado esperado: 201 Created con el total calculado y precios copiados
POST {{baseUrl}}/ventas/
Content-Type: application/json

{
  "cliente_id": 1,
  "renglones": [
    { "libro_id": 3, "cantidad": 2 },
    { "libro_id": 2, "cantidad": 1 }
  ]
}


### C-08: Búsqueda por título con texto malicioso (' OR '1'='1)
# Resultado esperado: 200 OK con lista vacía [] (parámetros ligados seguros)
GET {{baseUrl}}/libros/?titulo=%27%20OR%20%271%27=%271


### C-09: Listado de editoriales con paginación
# Resultado esperado: 200 OK con lista de editoriales paginada
GET {{baseUrl}}/editoriales?page=1&size=10


### C-10: Listado de géneros con paginación
# Resultado esperado: 200 OK con lista de géneros paginada
GET {{baseUrl}}/generos?page=1&size=10


### C-11: Listado de autores con paginación
# Resultado esperado: 200 OK con lista de autores paginada
GET {{baseUrl}}/autores?page=1&size=10


### C-12: Listado de libros con filtros (título y género)
# Resultado esperado: 200 OK con lista de libros filtrada y paginada
GET {{baseUrl}}/libros?titulo=Rayuela&genero_id=1


### C-13: Listado de ventas con paginación
# Resultado esperado: 200 OK con lista de ventas paginada
GET {{baseUrl}}/ventas?page=1&size=10


### C-15: Detalle de una venta específica (evidencia de cantidad fija de consultas sin N+1)
# Resultado esperado: 200 OK con datos de la venta y 2 consultas SQL fijas
GET {{baseUrl}}/ventas/1


### C-16: Verificación de perfil de cliente
# Resultado esperado: 200 OK con perfil de cliente o 404 si no tiene perfil
GET {{baseUrl}}/clientes/1/perfil


### C-07: Detalle de un libro y de una venta (evidencia de cantidad fija de consultas sin N+1)
# 1. Detalle de un libro (3 consultas SQL fijas)
GET {{baseUrl}}/libros/2

### 2. Detalle de una venta (2 consultas SQL fijas)
GET {{baseUrl}}/ventas/1

### Listar libros para ver IDs disponibles
GET {{baseUrl}}/libros/
