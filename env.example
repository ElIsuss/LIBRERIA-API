# Copiar este archivo como .env y completar con los valores reales.
# El .env NUNCA se versiona: esta es la unica fuente de la forma de la variable.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=libreria_api
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=3600
COOKIE_SECURE=false

# Bcrypt
BCRYPT_ROUNDS=12
BCRYPT_MAX_CONCURRENCY=4

# DB / SQLAlchemy
DB_POOL_SIZE=5
SQL_ECHO=false
