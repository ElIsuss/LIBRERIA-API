# Copiar este archivo como .env y completar con los valores reales.
# El .env NUNCA se versiona: esta es la unica fuente de la forma de la variable.

# Driver +asyncpg = motor asincrono. Sin ese sufijo SQLAlchemy busca un driver
# sincrono y falla. Formato:
#   postgresql+asyncpg://USUARIO:PASSWORD@localhost:PUERTO/NOMBRE_BASE
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/libreria_api

# Controla si las consultas emitidas se imprimen en la consola (diagnostico).
ECHO_SQL=false